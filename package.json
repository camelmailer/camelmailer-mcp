{
  "name": "camelmailer-mcp",
  "version": "0.1.0",
  "description": "MCP server for Camelmailer — let AI assistants send and inspect transactional email",
  "keywords": [
    "camelmailer",
    "mcp",
    "model-context-protocol",
    "email",
    "transactional",
    "claude"
  ],
  "homepage": "https://camelmailer.com",
  "bugs": {
    "url": "https://github.com/camelmailer/camelmailer-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camelmailer/camelmailer-mcp.git"
  },
  "license": "MIT",
  "author": "Camelmailer contributors",
  "type": "module",
  "bin": {
    "camelmailer-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "postinstall": "node scripts/ensure-camelmailer-dist.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "camelmailer": "github:camelmailer/camelmailer-node",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
